APP_NAME="Ventures Mart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=venturesmart
DB_USERNAME=root
DB_PASSWORD=

# Source SQLite file for one-time data copy (optional after cutover)
SQLITE_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty for host-only cookies (works with both localhost and 127.0.0.1).
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Real SMTP is required for customer OrderConfirmation delivery.
# MAIL_MAILER=log only writes to storage/logs — customers never receive mail.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=support@venturesmart.in
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@venturesmart.in"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_TO_EMAIL=neelkanthventures1804@gmail.com

# Use a Google App Password (or your host SMTP password) in MAIL_PASSWORD.
# If the mailbox is on StackCP instead of Gmail, set MAIL_HOST/PORT to the
# provider SMTP values and keep MAIL_USERNAME/MAIL_FROM_ADDRESS aligned.
#
# Local-only debugging (no inbox delivery):
# MAIL_MAILER=log
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Identity Services (Web client ID). Set both to the same literal value —
# Vite does not reliably expand ${GOOGLE_CLIENT_ID} the way Laravel does.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

INVOICE_PREFIX=VM
INVOICE_LEGAL_NAME="Neelkanth Emporium"
INVOICE_TRADE_NAME="Ventures Mart"
INVOICE_GSTIN=24EDLPK6446N1ZX
INVOICE_ADDRESS_LINE1="Shed no 2, first floor, opposite Patel corporation,"
INVOICE_ADDRESS_LINE2="Pan business park, Shapar,"
INVOICE_CITY=Rajkot
INVOICE_STATE=Gujarat
INVOICE_STATE_CODE=24
INVOICE_POSTAL_CODE=360024
INVOICE_COUNTRY=India
INVOICE_PHONE="+91 91732 79323"
INVOICE_EMAIL=neelkanthventures1804@gmail.com
INVOICE_WEBSITE=https://venturesmart.in
INVOICE_DEFAULT_HSN=9503
INVOICE_LOGO=images/ventures-mart-logo-invoice.png
INVOICE_ORDER_URL="https://venturesmart.in/orders/{number}"

# SEO / analytics (optional but recommended for production)
SEO_DEFAULT_LOCALE=en-IN
GOOGLE_SITE_VERIFICATION=FbCDbEAU2TcJuIMEUlki4N3dx2dxqVLd_ob9RWqV-_s
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=

# GST seller / place of supply (intra-state = CGST+SGST, else IGST)
GST_SELLER_STATE=Gujarat

# Razorpay (use rzp_test_* for test, rzp_live_* for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

# Shiprocket API user. Rotate credentials if they have ever been exposed.
SHIPROCKET_ENABLED=false
ORDER_FULFILLMENT_METHOD=shiprocket
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Use the same strong token in Shiprocket Settings > API > Webhooks (x-api-key).
SHIPROCKET_WEBHOOK_TOKEN=
# Leave blank to prefer a Shiprocket pickup matching INVOICE_POSTAL_CODE, then primary.
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_TIMEOUT=20
SHIPROCKET_FALLBACK_WEIGHT_KG=0.5
SHIPROCKET_FALLBACK_LENGTH_CM=20
SHIPROCKET_FALLBACK_BREADTH_CM=15
SHIPROCKET_FALLBACK_HEIGHT_CM=10

# Inventory thresholds and payment reservation TTL (minutes)
INVENTORY_DEFAULT_LOW_STOCK_THRESHOLD=5
INVENTORY_DEFAULT_REORDER_POINT=10
INVENTORY_PAYMENT_RESERVATION_TTL=15
INVENTORY_SEND_LOW_STOCK_EMAIL=false

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000,127.0.0.1:5173,localhost:5173
