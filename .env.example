APP_NAME="Ventures Mart"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=venturesmart
DB_USERNAME=root
DB_PASSWORD=

# Source SQLite file for one-time data copy (optional after cutover)
SQLITE_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=127.0.0.1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

CONTACT_TO_EMAIL=neelkanthventures1804@gmail.com

# For real Gmail delivery (use a Google App Password, not the account password):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=neelkanthventures1804@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM_ADDRESS=neelkanthventures1804@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Identity Services (Web client ID). Set both to the same literal value —
# Vite does not reliably expand ${GOOGLE_CLIENT_ID} the way Laravel does.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

INVOICE_PREFIX=VM
INVOICE_LEGAL_NAME="Neelkanth Emporium"
INVOICE_TRADE_NAME="Ventures Mart"
INVOICE_GSTIN=24EDLPK6446N1ZX
INVOICE_ADDRESS_LINE1="Shed no 2, first floor, opposite Patel corporation,"
INVOICE_ADDRESS_LINE2="Pan business park, Shapar,"
INVOICE_CITY=Rajkot
INVOICE_STATE=Gujarat
INVOICE_STATE_CODE=24
INVOICE_POSTAL_CODE=360024
INVOICE_COUNTRY=India
INVOICE_PHONE="+91 91732 79323"
INVOICE_EMAIL=neelkanthventures1804@gmail.com
INVOICE_WEBSITE=https://venturesmart.in
INVOICE_DEFAULT_HSN=9503
INVOICE_LOGO=images/ventures-mart-logo-invoice.png
INVOICE_ORDER_URL="https://venturesmart.in/orders/{number}"

# SEO / analytics (optional but recommended for production)
SEO_DEFAULT_LOCALE=en-IN
GOOGLE_SITE_VERIFICATION=
GA_MEASUREMENT_ID=
GTM_CONTAINER_ID=

# GST seller / place of supply (intra-state = CGST+SGST, else IGST)
GST_SELLER_STATE=Gujarat

# Razorpay (use rzp_test_* for test, rzp_live_* for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:8000,localhost:8000,127.0.0.1:5173,localhost:5173
